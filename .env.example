# Template for .env — copy to .env and fill in. .env is git-ignored.
# The CLI (python -m src.main) loads .env from the working directory;
# real environment variables always take precedence over this file.

# API key for test.openml.org (used with --test). The value shown is the
# test server's public demo key; replace with your own test-account key if
# you need write access beyond demo privileges.
OPENML_TEST_API_KEY=normaluser

# API key for production (www.openml.org). Get yours at https://www.openml.org/#api
#OPENML_API_KEY=
